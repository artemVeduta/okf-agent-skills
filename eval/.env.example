# Copy to `.env` in this directory or at the repository root, then fill in the
# credential. `.env` is git-ignored. Never commit a credential.
#
# Each provider reads its own variable. `opencode-go` reads OPENCODE_API_KEY.
# `anthropic` reads ANTHROPIC_API_KEY.
OPENCODE_API_KEY=""
OKF_EVAL_MODEL="opencode-go/deepseek-v4-pro"
OKF_EVAL_THINKING_LEVEL="max"
