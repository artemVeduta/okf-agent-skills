{
  "description": "Marker-gated, read-only orientation for OKF-managed bundles. Hook trust remains user-controlled.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "command": "node __OKF_SUITE_ROOT__/scripts/adapter-hook.js codex __OKF_TARGET_DIR__/manifest.json" }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          { "type": "command", "command": "node __OKF_SUITE_ROOT__/scripts/adapter-hook.js codex __OKF_TARGET_DIR__/manifest.json" }
        ]
      }
    ]
  }
}
